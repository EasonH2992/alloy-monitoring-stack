   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, job) (up{job=~\"integrations/.*\", host=~\"$host\"})",
     "legendFormat": "{{host}} {{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
