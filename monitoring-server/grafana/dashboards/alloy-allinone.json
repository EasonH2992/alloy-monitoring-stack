  {
   "id": 16,
   "type": "stat",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
