{
 "uid": "alloy-allinone",
 "title": "Alloy All-in-One",
 "description": "單一 Alloy 收集指標 (unix + cadvisor exporter, remote_write) 與 log (docker + journal) 的主機",
 "tags": [
  "monitoring",
  "alloy",
  "all-in-one"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "宿主機",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"integrations/unix\"}, host)",
     "refId": "host"
    },
    "definition": "label_values(up{job=\"integrations/unix\"}, host)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "sort": 1,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "container",
    "label": "容器",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(container_memory_working_set_bytes{job=\"integrations/cadvisor\", host=~\"$host\", name!=\"\"}, name)",
     "refId": "container"
    },
    "definition": "label_values(container_memory_working_set_bytes{job=\"integrations/cadvisor\", host=~\"$host\", name!=\"\"}, name)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "sort": 1,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "unit",
    "label": "systemd unit",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "type": 1,
     "label": "unit",
     "stream": "{job=\"journal\", host=~\"$host\"}",
     "refId": "unit"
    },
    "definition": "label_values(unit)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "sort": 1,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "search",
    "label": "Log 搜尋 (regex)",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Alloy agent 健康",
   "collapsed": false,
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "最後回報",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max by (host) (timestamp(up{job=\"integrations/unix\", host=~\"$host\"}))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "red",
        "value": 120
       }
      ]
     },
     "decimals": 0,
     "noValue": "已斷線 / 無資料"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "設定載入",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (alloy_config_last_load_successful{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "失敗",
         "color": "red"
        },
        "1": {
         "text": "OK",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "元件狀態",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 7,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (health_type) (alloy_component_controller_running_components{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{health_type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "healthy"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "unhealthy|exited"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Alloy 版本",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 11,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, version) (alloy_build_info{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "name"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "已執行",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 14,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max by (host) (alloy_resources_process_start_time_seconds{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Alloy 記憶體",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 17,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (alloy_resources_process_resident_memory_bytes{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Alloy CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum by (host) (rate(alloy_resources_process_cpu_seconds_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "row",
   "title": "資料管線（Alloy → Prometheus / Loki）",
   "collapsed": false,
   "id": 9,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "panels": []
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "指標推送 remote_write (samples/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host) (rate(prometheus_remote_storage_samples_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} 已送出"
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(prometheus_remote_storage_samples_failed_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} 失敗"
    },
    {
     "refId": "C",
     "expr": "sum by (host) (rate(prometheus_remote_storage_samples_retried_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} 重試"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*失敗"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*重試"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "指標推送延遲 / 待送佇列",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (prometheus_remote_storage_highest_timestamp_in_seconds{job=\"integrations/self\", host=~\"$host\"}) - max by (host) (prometheus_remote_storage_queue_highest_sent_timestamp_seconds{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{host}} 延遲 (s)"
    },
    {
     "refId": "B",
     "expr": "sum by (host) (prometheus_remote_storage_samples_pending{job=\"integrations/self\", host=~\"$host\"})",
     "legendFormat": "{{host}} 待送 samples"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*延遲.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*待送.*"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Log 推送 (entries/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host) (rate(loki_write_sent_entries_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} 已送出"
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(loki_write_dropped_entries_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} 丟棄"
    },
    {
     "refId": "C",
     "expr": "sum by (host) (rate(loki_write_batch_retries_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} 重試"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*丟棄"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*重試"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Log 來源 (lines/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host) (rate(loki_source_docker_target_entries_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} docker 容器"
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(loki_source_journal_target_lines_total{job=\"integrations/self\", host=~\"$host\"}[$__rate_interval]))",
     "legendFormat": "{{host}} journal"
    }
   ],
   "fieldConfig": {
    "defaults": {
